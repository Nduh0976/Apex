<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<!--
	  Path to MathEngine.csproj. Defaultes to a MathEngine clone
	  sitting next to this repo. Override it in Directory.Build.local.props,
	  with and environment variable, or with -p:MathEngineProject=... .
	-->
	  <MathEngineProject Condition="'$(MathEngineProject)' == ''">$(MSBuildThisFileDirectory)../../../MathEngine/src/MathEngine/MathEngine.csproj</MathEngineProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Apex\Apex.csproj" />
    <ProjectReference Include="$(MathEngineProject)" />
  </ItemGroup>
	<Target Name ="CheckMathEngineProject" BeforeTargets="ResolveProjectReferences">
		<Error Condition="!Exists('$(MathEngineProject)')" Text="MathEngine project not found at '$(MathEngineProject)'. Clone MathEngine next to this repo, or set MathEngineProject in Directory.Build.local.props (see README)." />
	</Target>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
